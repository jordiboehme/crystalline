flowchart LR
    %% the fourteen classic shapes mermaid draws
    sq[Square] --> ro(Round)
    ro --> st([Stadium])
    st --> sub[[Subroutine]]
    sub --> cyl[(Cylinder)]
    cyl --> ci((Circle))
    ci --> od>Odd]
    od --> di{Diamond}
    di --> hx{{Hexagon}}
    hx --> lr[/Lean right/]
    lr --> ll[\Lean left\]
    ll --> tr[/Trapezoid\]
    tr --> it[\Inverted/]
    it --> dc(((Double circle)))
