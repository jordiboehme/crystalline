{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    // Pinned rather than inherited: TypeScript 6 defaults `strict` to true, so
    // this is a no-op today, but it keeps the guarantee stated in the config
    // instead of resting on a compiler default that used to be false.
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "include": ["src"],
  // tokens.test.ts reads index.css off disk through node:fs/node:path, which
  // is Node-context code, not browser code; it typechecks under
  // tsconfig.node-test.json instead, the way vite.config.ts and the
  // Playwright suite already get their own Node-scoped project. Keeping it
  // out of this program is what keeps this program's Node-free guarantee
  // (no ambient `process`, no Node `Timeout` shadowing DOM `number`) true for
  // the rest of the app.
  "exclude": ["src/theme/tokens.test.ts"]
}
