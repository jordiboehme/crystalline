# Installed by 15-crystalline-base-path.sh only when CRYSTALLINE_BASE_PATH is
# set, and included at server level by default.conf.

# The bare prefix answers like the prefix with a slash, with no redirect: an
# MCP client never follows one, and the base tag makes a browser need none.
location = ${CRYSTALLINE_BASE_PATH} {
    rewrite ^ ${CRYSTALLINE_BASE_PATH}/index.html last;
}

# The OAuth documents at the host root: RFC 9728 and RFC 8414 insert the path
# after the host. The proxy in front has to forward these two paths here too.
location = /.well-known/oauth-protected-resource${CRYSTALLINE_BASE_PATH} {
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_http_version 1.1;
    proxy_pass http://${CRYSTALLINE_UPSTREAM};
}

location = /.well-known/oauth-authorization-server${CRYSTALLINE_BASE_PATH} {
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_http_version 1.1;
    proxy_pass http://${CRYSTALLINE_UPSTREAM};
}

# The same documents inside the prefix, for a client that appends.
location ${CRYSTALLINE_BASE_PATH}/.well-known/ {
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_http_version 1.1;
    proxy_pass http://${CRYSTALLINE_UPSTREAM};
}
