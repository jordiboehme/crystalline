<?xml version='1.0' encoding='utf-8'?>
<!--
  WiX v3 source consumed by `cargo wix` in .github/workflows/build.yml.
  For a local build (Windows only, WiX v3 on PATH or %WIX% set), run the
  exact cargo-wix invocation from that workflow's "Build .msi package" step
  after a release build of the crystalline package.

  Never change the UpgradeCode: in-place upgrades via `msiexec /i` depend on
  it staying identical across every released version.
-->
<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
  <Product Id='*'
      Name='Crystalline'
      UpgradeCode='A04060D9-E5E1-4E8E-8751-2DCA3D8896CC'
      Manufacturer='Jordi Böhme'
      Language='1033'
      Codepage='1252'
      Version='$(var.Version)'>

    <Package Keywords='Installer'
        Description='Local-first knowledge management for humans and AI agents.'
        Manufacturer='Jordi Böhme'
        InstallerVersion='450'
        Languages='1033'
        Compressed='yes'
        InstallScope='perMachine'
        SummaryCodepage='1252'/>

    <MajorUpgrade Schedule='afterInstallInitialize'
        DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

    <Media Id='1' Cabinet='media1.cab' EmbedCab='yes'/>

    <Directory Id='TARGETDIR' Name='SourceDir'>
      <Directory Id='$(var.PlatformProgramFilesFolder)' Name='PFiles'>
        <Directory Id='APPLICATIONFOLDER' Name='Crystalline'>
          <!-- CargoTargetDir is the workspace target/ directory, so ..\LICENSE
               resolves to the repository root license regardless of the
               invocation working directory. -->
          <Component Id='License' Guid='*'>
            <File Id='LicenseFile'
                Name='LICENSE'
                DiskId='1'
                Source='$(var.CargoTargetDir)\..\LICENSE'
                KeyPath='yes'/>
          </Component>
          <Directory Id='Bin' Name='bin'>
            <!-- Appends the bin directory to the machine PATH on install and
                 removes it again on uninstall (Permanent='no'). Lives in its
                 own default-on feature so an administrator can deselect it. -->
            <Component Id='Path' Guid='49D159B7-47A6-4F1C-8021-CE0C2BF02C9A' KeyPath='yes'>
              <Environment Id='PATH'
                  Name='PATH'
                  Value='[Bin]'
                  Permanent='no'
                  Part='last'
                  Action='set'
                  System='yes'/>
            </Component>
            <Component Id='CrystallineBinary' Guid='*'>
              <File Id='CrystallineExe'
                  Name='crystalline.exe'
                  DiskId='1'
                  Source='$(var.CargoTargetBinDir)\crystalline.exe'
                  KeyPath='yes'/>
            </Component>
          </Directory>
        </Directory>
      </Directory>
    </Directory>

    <Feature Id='Binaries'
        Title='Application'
        Description='Installs the crystalline command line tool.'
        Level='1'
        ConfigurableDirectory='APPLICATIONFOLDER'
        AllowAdvertise='no'
        Display='expand'
        Absent='disallow'>
      <ComponentRef Id='License'/>
      <ComponentRef Id='CrystallineBinary'/>
      <Feature Id='Environment'
          Title='PATH Environment Variable'
          Description='Adds the install location to the system PATH so crystalline is available from any terminal.'
          Level='1'
          Absent='allow'>
        <ComponentRef Id='Path'/>
      </Feature>
    </Feature>

    <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>
    <Property Id='ARPHELPLINK' Value='https://github.com/jordiboehme/crystalline'/>
    <Property Id='ARPURLINFOABOUT' Value='https://github.com/jordiboehme/crystalline'/>

    <!-- The Windows task \Crystalline\Daemon that starts the daemon for
         whoever signs in, outside any app package (Claude Desktop's bridge
         runs it on demand). The installed binary registers it, so the task
         names the folder it was really installed to. The register and the
         removal are deferred and not impersonated: they run as SYSTEM in
         the installer service's own session, so no console window reaches
         the desktop.
         The register runs after the files are in place, on install, repair
         and modify; the removal runs before the files go, on a real
         uninstall only. A major upgrade also removes the old product with
         REMOVE set to ALL, but with UPGRADINGPRODUCTCODE set as well: that
         removal leaves the task alone, and the new version's register then
         replaces it (the create forces over a task of the same name). So a
         register Windows refuses during an upgrade keeps the old task
         instead of leaving none. A failure in either action is ignored, so
         a task Windows refuses never rolls back the install; doctor reports
         a missing task and its fix registers one. The upgrade guard on the
         removal is permanent: every later version's cached MSI keeps it, so
         a later version that drops or renames the task must delete
         \Crystalline\Daemon itself on its own install. A rollback action
         undoes the register when a first install fails after it; it is
         skipped for a repair or an upgrade, so their rollback never deletes
         a task the machine already had. -->
    <CustomAction Id='RegisterDaemonTask'
        FileKey='CrystallineExe'
        ExeCommand='daemon-task register --all-users'
        Execute='deferred'
        Impersonate='no'
        Return='ignore'/>
    <CustomAction Id='RollbackRegisterDaemonTask'
        FileKey='CrystallineExe'
        ExeCommand='daemon-task unregister --all-users'
        Execute='rollback'
        Impersonate='no'
        Return='ignore'/>
    <CustomAction Id='UnregisterDaemonTask'
        FileKey='CrystallineExe'
        ExeCommand='daemon-task unregister --all-users'
        Execute='deferred'
        Impersonate='no'
        Return='ignore'/>
    <!-- Before any file is replaced or removed, end every running
         Crystalline task instance: the machine task and each per-user task
         (\Crystalline Daemon for *). A daemon a task started holds
         crystalline.exe open, and in another user's session the quiet
         install could not replace it. On a major upgrade the old product
         goes at RemoveExistingProducts, right after InstallInitialize, so
         the action runs before it. The new crystalline.exe is not
         installed yet at that point and the old one may know no such
         command, so Windows PowerShell does it; the script is
         end-daemon-tasks.ps1 beside this file, base64-encoded so formatted
         text never reads a bracket in it (crates/cli/tests/setup/wix.rs
         checks the two match). schtasks /End stops a daemon hard, without
         its clean shutdown, and only a daemon a task started: one started
         another way in another session is left to Restart Manager. The
         bridge starts the task again on its next request, and the logon
         trigger at the next sign-in. Runs as SYSTEM, which sees every
         user's task; a failure never stops the install. -->
    <CustomAction Id='EndDaemonTasks'
        Directory='TARGETDIR'
        ExeCommand='"[System64Folder]WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand '
        Execute='deferred'
        Impersonate='no'
        Return='ignore'/>
    <InstallExecuteSequence>
      <Custom Action='EndDaemonTasks' Before='RemoveExistingProducts'>Installed OR WIX_UPGRADE_DETECTED</Custom>
      <Custom Action='RollbackRegisterDaemonTask' Before='RegisterDaemonTask'>NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT REMOVE~="ALL"</Custom>
      <Custom Action='RegisterDaemonTask' After='InstallFiles'>NOT REMOVE~="ALL"</Custom>
      <Custom Action='UnregisterDaemonTask' Before='RemoveFiles'>REMOVE~="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
    </InstallExecuteSequence>

    <UI>
      <UIRef Id='WixUI_FeatureTree'/>
      <!-- No EULA dialog: the LICENSE file (MPL-2.0) installs beside the
           binary instead and the dialog order skips straight from the welcome
           page to feature selection. -->
      <Publish Dialog='WelcomeDlg' Control='Next' Event='NewDialog' Value='CustomizeDlg' Order='99'>1</Publish>
      <Publish Dialog='CustomizeDlg' Control='Back' Event='NewDialog' Value='WelcomeDlg' Order='99'>1</Publish>
    </UI>
  </Product>
</Wix>
